rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can read/write only their own profile and waste history.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /history/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Reward claims: a user can create and read only their own claims.
    // Claims cannot be edited or deleted from the app (status is changed by admin).
    match /rewards/{claimId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.points == 50
        && request.resource.data.status == "pending";
      allow update, delete: if false;
    }
  }
}
